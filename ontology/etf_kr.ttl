# =============================================================================
# etf_kr.ttl — 국내ETF 온톨로지
# 소스 테이블: tb_domestic_etf
# 이 파일은 build_ttl_from_meta.py 가 db/meta_columns/*.json 으로부터 자동 생성한다.
# 손으로 직접 편집하지 말 것 — 재생성 시 덮어써진다. 어휘/관계 정의는 common.ttl 참고.
# =============================================================================
@prefix fp:   <http://mafest.ai/product#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<> a owl:Ontology ;
   owl:imports <./common.ttl> ;
   rdfs:label "국내ETF 온톨로지"@ko .

# -----------------------------------------------------------------------------
# 다른 도메인 파일과 공유되어 여기서는 재선언하지 않는 속성 (중복 정의 방지)
# 실제 정의는 아래 목록의 소유 파일을 참고할 것 — 이 그래프에는 owl:imports 체인이
# 아니라 rdflib가 5개 파일을 함께 로드할 때만 완전해진다(완료 조건의 결합 그래프 검증 참고).
# -----------------------------------------------------------------------------
#   fp:pdNm  (정의: bond_kr.ttl, 공유 테이블: tb_domestic_bond, tb_domestic_etf, tb_foreign_etf)
#   fp:pdAbrvNm  (정의: bond_kr.ttl, 공유 테이블: tb_domestic_bond, tb_domestic_etf, tb_foreign_etf)
#   fp:pdEngNm  (정의: bond_kr.ttl, 공유 테이블: tb_domestic_bond, tb_domestic_etf)

# -----------------------------------------------------------------------------
# tb_domestic_etf 전용 속성 (65개)
# -----------------------------------------------------------------------------
fp:pdItmNo a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "표준종목코드 (ISIN)"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_itm_no|tb_foreign_etf.pd_itm_no" ;
    rdfs:comment "국내 상장 ETF의 국제표준식별코드(Primary Key, ISIN, 예: KR7069500007, KR7305080004)입니다."@ko .

fp:pdItmNoMa a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "단축종목코드 (Ticker/티커)"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_itm_no_ma|tb_foreign_etf.pd_itm_no_ma" ;
    rdfs:comment "HTS/MTS 및 주식 시장에서 주문 시 사용하는 6자리 단축 티커 코드(예: A069500, A305080, A371160)입니다."@ko .

fp:cuFundMgmtCo a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "운용사명 (자산운용사/브랜드)"@ko ;
    fp:sourceColumn "tb_domestic_etf.cu_fund_mgmt_co|tb_foreign_etf.cu_fund_mgmt_co" ;
    rdfs:comment "ETF를 설계하고 운용하는 자산운용사(예: 미래에셋자산운용/TIGER, 삼성자산운용/KODEX, KB자산운용/RISE, 한국투자신탁운용/ACE, 신한자산운용/SOL, 한화자산운용/PLUS 등)입니다."@ko .

fp:cuBaseIndex a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "기초지수명 (추종 벤치마크 지수)"@ko ;
    fp:sourceColumn "tb_domestic_etf.cu_base_index|tb_foreign_etf.cu_base_index" ;
    rdfs:comment "ETF가 100% 추종하거나 복제하는 기준 벤치마크 지수(예: KOSPI 200, S&P 500, NASDAQ 100, KRX 2차전지 K-뉴딜, 항셍테크)입니다."@ko ;
    fp:hasSynonym "S&P500 지수를 추종하는 국내 ETF 목록", "코스피200 기초지수 ETF", "나스닥100 지수 추종 ETF 찾아줘", "항셍테크 지수 복제하는 ETF", "미국 배당다우존스 지수 추종 상품" .

fp:cuChargeRt a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:decimal ;
    rdfs:label "총보수율 (TER/수수료)"@ko ;
    fp:sourceColumn "tb_domestic_etf.cu_charge_rt|tb_foreign_etf.cu_charge_rt" ;
    rdfs:comment "투자자가 연간 부담하는 운용보수, 판매보수, 수탁보수 등이 합산된 연간 총보수율(TER, %)입니다. ETF 투자 비용을 결정하는 핵심 지표입니다."@ko ;
    fp:hasSynonym "수수료(총보수) 제일 저렴한 S&P500 ETF", "가장 싼 국내 ETF 찾아줘", "총보수 0.1% 이하 저보수 ETF 추천", "보수율 낮은 순서대로 ETF 정렬", "운용 수수료 아낄 수 있는 ETF", "TER 총보수 비용 얼마야?" .

fp:cuChargeEtcRt a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "기타비용율"@ko ;
    fp:sourceColumn "tb_domestic_etf.cu_charge_etc_rt" ;
    rdfs:comment "총보수 외에 증권 매매중개 수수료 및 회계감사비 등 기타 부대비용율(%)입니다."@ko ;
    fp:hasSynonym "기타비용율 얼마야?", "실질 총비용(총보수+기타비용) 비교" .

fp:cuStrtegy a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "운용전략방식 (실물/합성/액티브)"@ko ;
    fp:sourceColumn "tb_domestic_etf.cu_strtegy|tb_foreign_etf.cu_strtegy" ;
    rdfs:comment "ETF의 실물복제, 합성복제, 액티브 운용 등 복제 기법 및 전략 방식입니다."@ko ;
    fp:hasSynonym "실물 복제 ETF야 합성 ETF야?", "액티브 운용 방식 ETF 목록", "합성복제 ETF 위험도" .

fp:cuLevFector a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "레버리지배수 (배수/인버스)"@ko ;
    fp:sourceColumn "tb_domestic_etf.cu_lev_fector" ;
    rdfs:comment "기초지수 일간 변동폭 대비 추종 배수(1: 1배수 정방향, 2: 2배 레버리지, -1: 인버스, -2: 2배 인버스/곱버스)입니다."@ko .

fp:cuUptDt a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:date ;
    rdfs:label "운용정보갱신일자"@ko ;
    fp:sourceColumn "tb_domestic_etf.cu_upt_dt|tb_foreign_etf.cu_upt_dt" ;
    rdfs:comment "기초지수 및 보수 정보가 갱신된 일자(YYYY-MM-DD)입니다."@ko .

fp:pdLstgDt a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:date ;
    rdfs:label "상장일자 (최초상장일)"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_lstg_dt|tb_foreign_etf.pd_lstg_dt" ;
    rdfs:comment "한국거래소(KRX)에 최초로 상장되어 거래가 개시된 일자(YYYY-MM-DD)입니다."@ko .

fp:pdLsteDt a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:date ;
    rdfs:label "상장폐지일자"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_lste_dt" ;
    rdfs:comment "상장 폐지가 결정되었거나 완료된 일자입니다 (정상 거래 종목은 9999-12-31 또는 결측)."@ko .

fp:pdSaleYn a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "판매여부 (매수가능여부)"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_sale_yn|tb_foreign_etf.pd_sale_yn" ;
    rdfs:comment "현재 정규 시장에서 매수/매도 주문이 가능한지 여부(Y: 거래가능, N: 거래불가)입니다."@ko .

fp:pdTrYn a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "거래정지여부"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_tr_yn|tb_foreign_etf.pd_tr_yn" ;
    rdfs:comment "한국거래소 규정에 따라 매매 거래가 정지되었는지 여부(Y: 거래정지, N: 정상거래)입니다."@ko .

fp:pdPenTrYn a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "연금계좌거래가능여부 (퇴직연금/IRP 매수가능)"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_pen_tr_yn" ;
    rdfs:comment "개인형 퇴직연금(IRP/DC) 및 연금저축 계좌에서 매수할 수 있는지 여부(Y: 연금매수가능, N: 연금매수불가/레버리지·인버스 등)입니다."@ko ;
    fp:hasSynonym "퇴직연금 IRP 계좌에서 살 수 있는 ETF 찾아줘", "IRP 계좌 매수 가능 ETF 목록", "연금저축계좌에서 투자할 수 있어?", "DC 퇴직연금 편입 가능한 종목만 보여줘", "연금계좌 투자 불가 종목 제외해줘" .

fp:pdPenRiskNm a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "연금거래위험구분 (안전자산/위험자산 구분)"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_pen_risk_nm" ;
    rdfs:comment "퇴직연금 감독규정상 위험자산(70% 한도)인지 안전자산(100% 투자 가능)인지 나타내는 구분(안전자산, 위험자산, N)입니다."@ko ;
    fp:hasSynonym "퇴직연금 안전자산 100% 채울 수 있는 ETF", "퇴직연금 70% 위험자산 한도 대상 ETF", "IRP 안전자산으로 인정되는 채권형 ETF 목록", "위험자산 비중 꽉 찼을 때 살 수 있는 안전자산 ETF", "퇴직연금 안전자산 분류 종목" .

fp:pdRiskCd a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "위험등급코드"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_risk_cd" ;
    rdfs:comment "투자 위험 등급 코드(PD_RISK_GCD_11: 1등급, 12: 2등급 등)입니다."@ko .

fp:pdRiskNm a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "위험등급명 (투자위험수준)"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_risk_nm" ;
    rdfs:comment "ETF의 투자 위험 수준(매우높은위험(1등급), 높은위험(2등급), 보통위험(4등급), 낮은위험 등)입니다."@ko ;
    fp:hasSynonym "낮은 위험의 안전한 ETF 추천해줘", "초고위험(1등급) 주식형 ETF 목록", "보통위험 이하 안정적인 상품" .

fp:pdSpacYn a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "스팩여부"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_spac_yn" ;
    rdfs:comment "기업인수목적회사(SPAC) 여부(Y/N)입니다 (일반 ETF는 모두 N)."@ko .

fp:pdSectCd a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "섹터코드"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_sect_cd" ;
    rdfs:comment "한국거래소 기준 산업 섹터 분류 코드입니다."@ko .

fp:pdCurrCd a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "통화코드"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_curr_cd|tb_foreign_etf.pd_curr_cd" ;
    rdfs:comment "거래 기준 통화 코드(CURR_CD_KRW 등)입니다."@ko .

fp:pdCurrNm a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "통화명"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_curr_nm" ;
    rdfs:comment "거래 통화 한글명(한국원화 등)입니다."@ko .

fp:pdExgMktCd a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "거래소시장코드"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_exg_mkt_cd|tb_foreign_etf.pd_exg_mkt_cd" ;
    rdfs:comment "상장 거래소 시장 식별코드입니다."@ko .

fp:pdExgMktNm a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "거래소시장명"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_exg_mkt_nm" ;
    rdfs:comment "상장된 거래소 시장 이름(유가증권, 코스닥 등)입니다."@ko .

fp:pdGrpNo a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "그룹번호 (상품유형)"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_grp_no|tb_foreign_etf.pd_grp_no" ;
    rdfs:comment "내부 상품 그룹 식별번호(ETF, ETN)입니다."@ko .

fp:pdMktId a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "시장ID"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_mkt_id|tb_foreign_etf.pd_mkt_id" ;
    rdfs:comment "시장 식별자(STK, KSQ 등)입니다."@ko .

fp:pdMktNm a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:string ;
    rdfs:label "시장명"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_mkt_nm" ;
    rdfs:comment "시장 풀네임입니다."@ko .

fp:wuCoreYn a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "핵심추천ETF여부 (코어 추천종목)"@ko ;
    fp:sourceColumn "tb_domestic_etf.wu_core_yn|tb_foreign_etf.wu_core_yn" ;
    rdfs:comment "미래에셋증권 리서치/자산배분 본부에서 선정한 포트폴리오 핵심 추천 ETF 종목 여부(Y/N)입니다."@ko .

fp:wuInvAstType a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "투자자산군 (자산분류 1축)"@ko ;
    fp:sourceColumn "tb_domestic_etf.wu_inv_ast_type|tb_foreign_etf.wu_inv_ast_type" ;
    rdfs:comment "AI 테마 분류 1축(Axis 1)으로 주식, 채권, 원자재, 단기자금 등 주요 투자 대상 자산 분류입니다."@ko ;
    fp:hasSynonym "해외 주식형 ETF 찾아줘", "국내 채권형 ETF 목록", "원자재 금 ETF 보여줘", "주식형 ETF만 모아서 보여줘" .

fp:wuInvRgn a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:string ;
    rdfs:label "투자지역 (지리적 분류 2축)"@ko ;
    fp:sourceColumn "tb_domestic_etf.wu_inv_rgn|tb_foreign_etf.wu_inv_rgn" ;
    rdfs:comment "AI 테마 분류 2축(Axis 2)으로 국내, 미국, 중국, 일본, 글로벌, 유럽, 신흥국 등 자산이 투자되는 지리적 지역입니다."@ko ;
    fp:hasSynonym "미국에 투자하는 국내 상장 ETF", "중국 테크 시장에 투자하는 ETF", "일본 증시 투자 ETF 찾아줘", "글로벌 전세계 분산투자 ETF" .

fp:wuUptDt a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:date ;
    rdfs:label "추천정보갱신일자"@ko ;
    fp:sourceColumn "tb_domestic_etf.wu_upt_dt|tb_foreign_etf.wu_upt_dt" ;
    rdfs:comment "AI 테마 분류 및 추천 정보가 갱신된 일자입니다."@ko .

fp:pdLstPrice a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:decimal ;
    rdfs:label "상장원금 (공모가/최초설정가)"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_lst_price|tb_foreign_etf.pd_lst_price" ;
    rdfs:comment "상장 당시 최초 설정 기준 가격(원 단위, 통상 10,000원 또는 50,000원)입니다."@ko .

fp:pdLstStkCnt a owl:DatatypeProperty ;
    rdfs:domain fp:ETF ; rdfs:range xsd:decimal ;
    rdfs:label "상장주식수 (최초발행주식수)"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_lst_stk_cnt|tb_foreign_etf.pd_lst_stk_cnt" ;
    rdfs:comment "상장 당시 최초 발행된 주식수(좌수)입니다."@ko .

fp:pdStkCnt a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "총발행주식수 (현재상장좌수)"@ko ;
    fp:sourceColumn "tb_domestic_etf.pd_stk_cnt" ;
    rdfs:comment "현재 설정되어 유통 중인 ETF의 총 상장 좌수(주식수)입니다."@ko .

fp:pdCircStkCnt a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "유통주식수"@ko ;
