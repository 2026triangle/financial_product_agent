    rdfs:comment "ETF의 총 발행 주식수 × 현재가로 계산된 시장 전체 시가총액 규모(원 단위)입니다. 유동성과 대형주 여부를 판단하는 지표입니다."@ko ;
    fp:hasSynonym "시가총액 1조 이상 대형 ETF 찾아줘", "규모 제일 큰 ETF 순서대로 보여줘", "시가총액 상위 종목 목록", "시총 5000억 넘는 인기 ETF" .

fp:pdNavPshr a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "주당순자산가치 (NAV/본질가치)"@ko ;
