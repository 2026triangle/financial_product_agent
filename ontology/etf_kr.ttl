fp:duVal1m a owl:DatatypeProperty ;
    rdfs:domain fp:DomesticETF ; rdfs:range xsd:decimal ;
    rdfs:label "1개월 평균 거래대금"@ko ;
    fp:sourceColumn "tb_domestic_etf.du_val_1m" ;
