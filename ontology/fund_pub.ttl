# =============================================================================
# fund_pub.ttl — 공모펀드 온톨로지
# 소스 테이블: tb_fund, tb_fund_attribute
# 이 파일은 build_ttl_from_meta.py 가 db/meta_columns/*.json 으로부터 자동 생성한다.
# 손으로 직접 편집하지 말 것 — 재생성 시 덮어써진다. 어휘/관계 정의는 common.ttl 참고.
# =============================================================================
@prefix fp:   <http://mafest.ai/product#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<> a owl:Ontology ;
   owl:imports <./common.ttl> ;
   rdfs:label "공모펀드 온톨로지"@ko .

# -----------------------------------------------------------------------------
# 다른 도메인 파일과 공유되어 여기서는 재선언하지 않는 속성 (중복 정의 방지)
# 실제 정의는 아래 목록의 소유 파일을 참고할 것 — 이 그래프에는 owl:imports 체인이
# 아니라 rdflib가 5개 파일을 함께 로드할 때만 완전해진다(완료 조건의 결합 그래프 검증 참고).
# -----------------------------------------------------------------------------
#   fp:currCd  (정의: bond_kr.ttl, 공유 테이블: tb_domestic_bond, tb_fund)

# -----------------------------------------------------------------------------
# tb_fund 전용 속성 (43개)
# -----------------------------------------------------------------------------
fp:itmNo a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "펀드표준코드 (ISIN)"@ko ;
    fp:sourceColumn "tb_fund.itm_no|tb_fund_attribute.itm_no" ;
    rdfs:comment "개별 클래스 펀드의 고유 국제표준코드(Primary Key, ISIN, 예: KR5116450039)입니다."@ko .

fp:itmNm a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "펀드정식명칭 (공식 풀네임)"@ko ;
    fp:sourceColumn "tb_fund.itm_nm" ;
    rdfs:comment "운용사, 펀드 전략, 투자 유형 및 클래스(Class A, C, C-e, Pe 등)가 모두 포함된 펀드 공식 풀네임입니다."@ko .

fp:itmAbrvNm a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "펀드약어명 (단축 표기명)"@ko ;
    fp:sourceColumn "tb_fund.itm_abrv_nm" ;
    rdfs:comment "HTS/MTS 화면 표기 및 검색용 단축 펀드명(예: 신한BNPP차이나1[주식]ClassC1, 미래에셋글로벌컨슈머(주식)C-e)입니다."@ko .

fp:itmEngNm a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "펀드영문명"@ko ;
    fp:sourceColumn "tb_fund.itm_eng_nm" ;
    rdfs:comment "펀드 공식 영문 명칭입니다."@ko .

fp:itmEabrvNm a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "펀드약어영문명"@ko ;
    fp:sourceColumn "tb_fund.itm_eabrv_nm" ;
    rdfs:comment "펀드 단축 영문 명칭입니다."@ko .

fp:stdItmNo a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "표준상품코드"@ko ;
    fp:sourceColumn "tb_fund.std_itm_no" ;
    rdfs:comment "표준 금융상품 식별코드입니다."@ko .

fp:ksdItmNo a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "예탁원코드 (자펀드 예탁원코드)"@ko ;
    fp:sourceColumn "tb_fund.ksd_itm_no" ;
    rdfs:comment "한국예탁결제원(KSD) 개별 자펀드 등록코드입니다."@ko .

fp:rpttKsdItmNo a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "대표예탁원코드 (모펀드 식별키)"@ko ;
    fp:sourceColumn "tb_fund.rptt_ksd_itm_no" ;
    rdfs:comment "모펀드(대표 펀드)의 고유 예탁원 식별코드입니다. 동일한 모펀드에 연결된 여러 수수료 클래스(A, C, C-e, Pe 등)를 묶어주는 상위 조인키입니다."@ko .

fp:fssItmNo a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "금융감독원 DART 공시코드"@ko ;
    fp:sourceColumn "tb_fund.fss_itm_no" ;
    rdfs:comment "금융감독원 DART 전자공시시스템 펀드 고유 등록 식별코드입니다."@ko .

fp:kofiaFdCcd a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "금융투자협회 분류코드"@ko ;
    fp:sourceColumn "tb_fund.kofia_fd_ccd" ;
    rdfs:comment "금융투자협회 전자공시 포털 펀드 표준 분류코드입니다."@ko .

fp:mtcoItmNo a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "운용사 내부 종목코드"@ko ;
    fp:sourceColumn "tb_fund.mtco_itm_no" ;
    rdfs:comment "자산운용사 내부 펀드 관리 전산코드입니다."@ko .

fp:orCoXtnIttCd a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "운용사 대외기관코드"@ko ;
    fp:sourceColumn "tb_fund.or_co_xtn_itt_cd" ;
    rdfs:comment "자산운용사의 8자리 표준 대외기관 식별코드(예: 00040010: 미래에셋자산운용, 00020054: 신한자산운용 등)입니다."@ko .

fp:truscXtnIttCd a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "수탁회사 대외기관코드"@ko ;
    fp:sourceColumn "tb_fund.trusc_xtn_itt_cd" ;
    rdfs:comment "펀드 자산을 보관/관리하는 수탁 신탁은행(KB국민은행, 신한은행, 하나은행 등)의 8자리 표준 기관코드입니다."@ko .

fp:bmrkNm a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "벤치마크 지수명 (비교지수)"@ko ;
    fp:sourceColumn "tb_fund.bmrk_nm" ;
    rdfs:comment "펀드의 운용 성과를 평가하는 기준 비교 벤치마크 지수(예: KOSPI 200, MSCI CHINA 85% + Call 15%, KIS 종합채권 등)입니다."@ko .

fp:bmrkEngNm a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "벤치마크 영문명"@ko ;
    fp:sourceColumn "tb_fund.bmrk_eng_nm" ;
    rdfs:comment "벤치마크 지수 영문 명칭입니다."@ko .

fp:exchdgYn a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "환헤지적용여부 (H/UH 환노출)"@ko ;
    fp:sourceColumn "tb_fund.exchdg_yn" ;
    rdfs:comment "해외 투자 펀드의 환위험 헷지 전략 여부(Y: 환헤지형/H, N: 환노출/언헤지/UH, NaN: 국내투자 해당없음)입니다."@ko ;
    fp:hasSynonym "환헤지(H) 되는 미국 펀드 찾아줘", "환노출(UH) 해외 펀드 목록", "환율 상승에 베팅하는 환노출형 펀드", "환헤지 적용 여부 확인해줘" .

fp:ovrsFdDesc a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "해외펀드구분 (국내/해외/혼합)"@ko ;
    fp:sourceColumn "tb_fund.ovrs_fd_desc" ;
    rdfs:comment "펀드의 투자 지역 대분류(국내: 국내자산 투자, 해외: 해외자산 투자, 국내외혼합)입니다."@ko .

fp:fdIvstRgnDesc a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "투자지역상세 (국가/대륙)"@ko ;
    fp:sourceColumn "tb_fund.fd_ivst_rgn_desc" ;
    rdfs:comment "펀드가 주로 투자하는 세부 국가 및 대륙 지역(글로벌, 국내, 미국/북미, 중국, 유럽, 신흥국, 아시아 등)입니다."@ko .

fp:orAttrDesc a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "운용자산유형 (주식형/채권형/혼합형)"@ko ;
    fp:sourceColumn "tb_fund.or_attr_desc" ;
    rdfs:comment "펀드의 핵심 투자 대상 자산 유형(주식형, 채권형, 주식혼합형, 채권혼합형, MMF, 재간접형, 파생형 등)입니다."@ko ;
    fp:hasSynonym "주식형 펀드 찾아줘", "안전한 채권형 펀드 추천", "MMF 단기자금 펀드 목록", "글로벌 재간접 펀드" .

fp:fdEstbCtryCd a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "펀드설립국가코드"@ko ;
    fp:sourceColumn "tb_fund.fd_estb_ctry_cd" ;
    rdfs:comment "펀드가 설립 등록된 3자리 국가코드(000: 국내설립 역내펀드, 410: 해외설립 역외펀드)입니다."@ko .

fp:fdSetPcd a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "펀드설정유형코드 (추가형/단위형)"@ko ;
    fp:sourceColumn "tb_fund.fd_set_pcd" ;
    rdfs:comment "펀드 설정 방식(10: 수시 추가 매수가 가능한 추가형, 20: 모집 기간에만 가입하는 단위형)입니다."@ko .

fp:prvoPbffDesc a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "공모/사모구분"@ko ;
    fp:sourceColumn "tb_fund.prvo_pbff_desc" ;
    rdfs:comment "일반 대중 대상 모집 여부(공모)입니다."@ko .

fp:prvoFdDesc a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "사모펀드구분"@ko ;
    fp:sourceColumn "tb_fund.prvo_fd_desc" ;
    rdfs:comment "사모펀드 구분 속성입니다."@ko .

fp:zrinFdIvstRiskGcd a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "위험등급코드 (제로인 평가)"@ko ;
    fp:sourceColumn "tb_fund.zrin_fd_ivst_risk_gcd" ;
    rdfs:comment "펀드평가사 제로인 기준 투자위험등급(1: 매우높은위험, 2: 높은위험, 3: 다소높은위험, 4: 보통위험, 5: 낮은위험, 6: 매우낮은위험)입니다."@ko ;
    fp:hasSynonym "1등급 초고위험 주식 펀드", "5등급 또는 6등급 안전한 저위험 펀드 추천해줘" .

fp:zrinFdIvstRiskGrdNm a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "위험등급명 (안전도/위험수준)"@ko ;
    fp:sourceColumn "tb_fund.zrin_fd_ivst_risk_grd_nm" ;
    rdfs:comment "펀드 위험 수준 한글 명칭(매우 높은 위험, 높은 위험, 다소 높은 위험, 보통 위험, 낮은 위험, 매우 낮은 위험)입니다."@ko ;
    fp:hasSynonym "낮은 위험 등급의 안정적인 펀드 찾아줘", "원금 손실 걱정 적은 매우 낮은 위험 펀드", "매우 높은 위험 등급 주식형 펀드" .

fp:saleYn a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "판매상태 (신규가입가능여부)"@ko ;
    fp:sourceColumn "tb_fund.sale_yn" ;
    rdfs:comment "현재 신규 가입 및 매수가 가능한 상태(판매중)인지 마감된 상태(판매완료/종료)인지 나타냅니다."@ko .

fp:thcoSaleYn a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "당사(미래에셋)판매여부"@ko ;
    fp:sourceColumn "tb_fund.thco_sale_yn" ;
    rdfs:comment "미래에셋증권 영업점 또는 MTS/HTS 온라인에서 실제로 가입/매수 가능한 펀드 여부(Y: 당사판매, NaN: 타사전용)입니다."@ko .

fp:frcBprItmYn a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "외화기준가여부 (외화펀드)"@ko ;
    fp:sourceColumn "tb_fund.frc_bpr_itm_yn" ;
    rdfs:comment "달러(USD) 등 외화로 기준가격이 산출되는 펀드인지 여부(Y: 외화기준가, N: 원화기준가)입니다."@ko .

fp:hdgeFdYn a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "헤지펀드여부"@ko ;
    fp:sourceColumn "tb_fund.hdge_fd_yn" ;
    rdfs:comment "사모전문 헤지펀드 여부(N)입니다."@ko .

fp:ofsfdYn a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "역외펀드여부"@ko ;
    fp:sourceColumn "tb_fund.ofsfd_yn" ;
    rdfs:comment "해외 법률에 따라 설립된 역외 펀드 여부(N)입니다."@ko .

fp:persCorpDesc a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "개인/법인구분 (가입대상)"@ko ;
    fp:sourceColumn "tb_fund.pers_corp_desc" ;
    rdfs:comment "가입 대상 고객 구분(전체: 개인/법인 모두 가능, 개인전용: 개인만 가능, 법인전용: 법인 전용 클래스)입니다."@ko .

fp:pfivSaleCntlTcd a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "전문투자자판매제어코드"@ko ;
    fp:sourceColumn "tb_fund.pfiv_sale_cntl_tcd" ;
    rdfs:comment "가입 자격 제한 코드(00: 일반투자자 가입 가능, 01/02: 전문투자자 전용)입니다."@ko .

fp:intDvdDesc a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:string ;
    rdfs:label "이자/배당구분 (수익금 지급방식)"@ko ;
    fp:sourceColumn "tb_fund.int_dvd_desc" ;
    rdfs:comment "펀드 결산 수익금 지급 방식(재투자, 현금지급 등)입니다."@ko .

fp:fdNastSuma a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:decimal ;
    rdfs:label "순자산총액 (설정액/펀드규모)"@ko ;
    fp:sourceColumn "tb_fund.fd_nast_suma" ;
    rdfs:comment "해당 펀드 클래스의 총 순자산 설정액 규모(원 단위)입니다. 펀드 유동성, 자금 유입 규모 및 안정성을 파악하는 핵심 지표입니다."@ko ;
    fp:hasSynonym "순자산 1000억 이상 대형 공모펀드 추천", "사람들이 제일 많이 가입한 펀드 찾아줘", "설정액 규모 큰 펀드 순서대로 정렬", "순자산총액 규모 1위 펀드", "안정적으로 돈이 많이 몰린 대형 펀드" .

fp:fdWk1ErnR a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:decimal ;
    rdfs:label "1주일 수익률"@ko ;
    fp:sourceColumn "tb_fund.fd_wk1_ern_r" ;
    rdfs:comment "최근 1주일간의 기준가 누적 수익률(%)입니다."@ko ;
    fp:hasSynonym "최근 일주일간 수익률" .

fp:fdMm1ErnR a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:decimal ;
    rdfs:label "1개월 수익률"@ko ;
    fp:sourceColumn "tb_fund.fd_mm1_ern_r" ;
    rdfs:comment "최근 1개월(30일)간의 기준가 누적 수익률(%)입니다."@ko ;
    fp:hasSynonym "최근 1개월 수익률 높은 펀드 찾아줘", "한달 성과 상위 펀드" .

fp:fdMm3ErnR a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:decimal ;
    rdfs:label "3개월 수익률"@ko ;
    fp:sourceColumn "tb_fund.fd_mm3_ern_r" ;
    rdfs:comment "최근 3개월(90일)간의 기준가 누적 수익률(%)입니다."@ko ;
    fp:hasSynonym "최근 3개월 단기 성과 좋은 펀드" .

fp:fdMm6ErnR a owl:DatatypeProperty ;
    rdfs:domain fp:Fund ; rdfs:range xsd:decimal ;
    rdfs:label "6개월 수익률"@ko ;
    fp:sourceColumn "tb_fund.fd_mm6_ern_r" ;
    rdfs:comment "최근 6개월(180일)간의 기준가 누적 수익률(%)입니다."@ko ;
