fp:prfdAttrCd a owl:DatatypeProperty ;
    rdfs:domain fp:AttributeTag ; rdfs:range xsd:string ;
    rdfs:label "공모펀드속성코드 (테마/우대 분류태그)"@ko ;
    fp:sourceColumn "tb_fund_attribute.prfd_attr_cd" ;
    rdfs:comment "펀드에 부여된 다차원 테마/스타일/투자전략/우대 속성 분류 태그 코드(예: F103: ESG/사회책임, N143: 반도체, V102: 가치주, H101: 배당주 등 95,618건 다중 매핑)입니다."@ko ;
    fp:hasSynonym "속성코드 F103을 보유한 ESG 펀드 목록 찾아줘", "특정 테마 속성 태그가 매핑된 펀드 조회", "반도체/배당 속성코드 검색", "속성 태그별 펀드 필터링" .
