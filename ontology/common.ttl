# =============================================================================
# common.ttl — 금융상품 공통 온톨로지 (TBox)
# 대회 제출 규격: @prefix fp: <http://mafest.ai/product#>
# bond_kr.ttl / etf_kr.ttl / etf_gl.ttl / fund_pub.ttl 이 owl:imports 로 참조
#
# 설계 원칙
#  L1 개념 : 클래스 계층 · 관계 · 속성
#  L2 어휘 : 허용값 인스턴스 + fp:rank(순서) + fp:hasSynonym(상품군별 표기)
#  L3 매핑 : fp:sourceTable / fp:sourceColumn — 런타임 검증·SQL 라우팅·그래프 생성의 재료
#
# 모든 어휘값은 perprocessed_datas/v4 실측 기준 (ontology/vocab/*.json)
# =============================================================================
@prefix fp:   <http://mafest.ai/product#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<> a owl:Ontology ;
   rdfs:label "금융상품 공통 온톨로지"@ko ;
   rdfs:comment "국내채권/국내ETF/해외ETF/공모펀드 4개 도메인의 상위 클래스, 참조 엔티티, 통제 어휘 정의. 데이터 기준일 2026-07-11"@ko .

# =============================================================================
# 0. 애노테이션 프로퍼티 — 온톨로지를 '실행 가능'하게 만드는 층
# =============================================================================
fp:sourceTable   a owl:AnnotationProperty ; rdfs:label "소스 테이블"@ko .
fp:sourceColumn  a owl:AnnotationProperty ; rdfs:label "소스 컬럼"@ko .
fp:sourceFilter  a owl:AnnotationProperty ; rdfs:label "소스 필터"@ko ;
    rdfs:comment "같은 테이블 안에서 클래스를 가르는 SQL 조건 (예: ETF/ETN 구분)"@ko .
fp:primaryKey    a owl:AnnotationProperty ; rdfs:label "기본키"@ko .
fp:graphLabel    a owl:AnnotationProperty ; rdfs:label "Neo4j 노드 라벨"@ko .
fp:hasSynonym    a owl:AnnotationProperty ; rdfs:label "동의어/구어체/상품군별 표기"@ko .
fp:valueCode     a owl:AnnotationProperty ; rdfs:label "원천 코드값"@ko ;
    rdfs:comment "상품군마다 표기가 달라 복수 지정. 형식: '<테이블>:<원천값>'. 같은 테이블에 여러 개가 있으면 서로 다른 행을 가리키는 peer 값들이다(예: Region의 국가별 값) — normalize_value는 raw가 그중 하나와 일치하면 그대로(뭉개지 않고) 반환한다"@ko .
fp:altValueCode  a owl:AnnotationProperty ; rdfs:label "대체 원천값(별칭 컬럼)"@ko ;
    rdfs:comment "fp:valueCode와 형식은 같지만('<테이블>:<원천값>'), 서로 다른 행이 아니라 같은 행의 다른 컬럼이 같은 사실을 표기한 별칭이다(예: 국내ETF 위험등급의 pd_risk_nm 이름형은 pd_risk_cd 코드형의 별칭). normalize_value는 이 값으로 매칭되면 그 값 자체가 아니라 같은 테이블의 fp:valueCode(대표값)로 정규화해 반환한다"@ko .
fp:rank          a owl:AnnotationProperty ; rdfs:label "서열"@ko ;
    rdfs:comment "부등호 질의('AA- 이상','위험등급 낮은')를 결정론적으로 변환하기 위한 순위. 작을수록 상위"@ko .
fp:notAvailableIn a owl:AnnotationProperty ; rdfs:label "미제공 상품군"@ko ;
    rdfs:comment "해당 개념이 존재하지 않는 상품군. '확인할 수 없음' 응답 및 역질문 판단 근거"@ko .
fp:categoryLevel a owl:AnnotationProperty ; rdfs:label "분류 계층 레벨"@ko ;
    rdfs:comment "'major'|'mid'|'minor'. fp:BondCategory처럼 트리가 아닌 DAG 통제어휘에서 같은 레벨끼리만 비교·전개하기 위한 값"@ko .

# =============================================================================
# 1. 클래스 계층
# =============================================================================
fp:Product a owl:Class ;
    rdfs:label "금융상품"@ko ;
    fp:graphLabel "Product" .

fp:Bond a owl:Class ;
    rdfs:subClassOf fp:Product ;
    rdfs:label "국내채권"@ko ;
    fp:sourceTable "tb_domestic_bond" ; fp:primaryKey "pd_no" ; fp:graphLabel "Bond" .

# ETF/ETN은 같은 마스터에 섞여 있음 (국내 1,734건 중 ETN 532건 / 해외 5,646건 중 ETN 59건)
# pd_grp_no 로 구분하며, "ETF 알려줘" 질의에 ETN을 섞지 않기 위해 클래스를 분리한다.
fp:ETF a owl:Class ;
    rdfs:subClassOf fp:Product ;
    rdfs:label "상장지수펀드(ETF)"@ko ;
    fp:sourceFilter "pd_grp_no = 'ETF'" ; fp:graphLabel "ETF" .

fp:ETN a owl:Class ;
    rdfs:subClassOf fp:Product ;
    rdfs:label "상장지수증권(ETN)"@ko ;
    rdfs:comment "ETF와 형제 클래스. 발행사 신용위험을 지는 별개 상품이므로 ETF 질의에 포함하지 않는다"@ko ;
    fp:sourceFilter "pd_grp_no = 'ETN'" ; fp:graphLabel "ETN" .

fp:DomesticETF a owl:Class ;
    rdfs:subClassOf fp:ETF ; rdfs:label "국내 ETF"@ko ;
    fp:sourceTable "tb_domestic_etf" ; fp:primaryKey "pd_itm_no" ; fp:graphLabel "DomesticETF" .

fp:ForeignETF a owl:Class ;
    rdfs:subClassOf fp:ETF ; rdfs:label "해외 ETF"@ko ;
    fp:sourceTable "tb_foreign_etf" ; fp:primaryKey "pd_itm_no" ; fp:graphLabel "ForeignETF" .

fp:Fund a owl:Class ;
    rdfs:subClassOf fp:Product ; rdfs:label "공모펀드"@ko ;
    fp:sourceTable "tb_fund" ; fp:primaryKey "itm_no" ; fp:graphLabel "Fund" .

# =============================================================================
# 2. 참조 엔티티 클래스
# =============================================================================
fp:Institution a owl:Class ; rdfs:label "기관(발행기관/운용사)"@ko ; fp:graphLabel "Institution" ;
    rdfs:comment "채권 발행기관(pd_pbcm) 또는 ETF/펀드 운용사(cu_fund_mgmt_co). 역할은 관계로 구분하며, 표기 정규화(Entity Resolution) 대상"@ko .
fp:BenchmarkIndex a owl:Class ; rdfs:label "기초지수/벤치마크"@ko ; fp:graphLabel "BenchmarkIndex" .
fp:RiskGrade   a owl:Class ; rdfs:label "위험등급"@ko ; fp:graphLabel "RiskGrade" .
fp:CreditRating a owl:Class ; rdfs:label "신용등급"@ko ; fp:graphLabel "CreditRating" .
fp:AssetClass  a owl:Class ; rdfs:label "투자자산군"@ko ; fp:graphLabel "AssetClass" .
fp:Region      a owl:Class ; rdfs:label "투자지역"@ko ; fp:graphLabel "Region" .
fp:BondCategory a owl:Class ; rdfs:label "채권분류"@ko ; fp:graphLabel "BondCategory" ;
    rdfs:comment "대분류(std_pd_mcls_nm 6종) > 중분류(std_pd_scls_nm 16종) > 소분류(bd_knd 39종) 3계층"@ko .
fp:AttributeTag a owl:Class ; rdfs:label "펀드속성태그"@ko ; fp:graphLabel "AttributeTag" ;
    fp:sourceTable "tb_fund_attribute" .

# =============================================================================
# 3. 객체 속성(관계) — 그래프의 엣지
# =============================================================================
fp:issuedBy a owl:ObjectProperty ; rdfs:domain fp:Bond ; rdfs:range fp:Institution ;
    rdfs:label "발행기관"@ko ; fp:sourceColumn "tb_domestic_bond.pd_pbcm" ; fp:graphLabel "ISSUED_BY" .
fp:managedBy a owl:ObjectProperty ; rdfs:domain fp:Product ; rdfs:range fp:Institution ;
    rdfs:label "운용사"@ko ; fp:sourceColumn "cu_fund_mgmt_co" ; fp:graphLabel "MANAGED_BY" .
fp:tracksIndex a owl:ObjectProperty ; rdfs:domain fp:Product ; rdfs:range fp:BenchmarkIndex ;
    rdfs:label "추종/벤치마크 지수"@ko ; fp:graphLabel "TRACKS" .
fp:hasRiskGrade a owl:ObjectProperty ; rdfs:domain fp:Product ; rdfs:range fp:RiskGrade ;
    rdfs:label "위험등급"@ko ; fp:graphLabel "HAS_RISK_GRADE" ;
    fp:notAvailableIn "tb_foreign_etf" .
fp:hasCreditRating a owl:ObjectProperty ; rdfs:domain fp:Bond ; rdfs:range fp:CreditRating ;
    rdfs:label "신용등급"@ko ; fp:sourceColumn "tb_domestic_bond.crd_grd" ; fp:graphLabel "HAS_CREDIT_RATING" ;
    rdfs:comment "채권 전용. 42,394건 중 24,750건만 보유(58%)"@ko .
fp:investsInAssetClass a owl:ObjectProperty ; rdfs:domain fp:Product ; rdfs:range fp:AssetClass ;
    rdfs:label "투자자산군"@ko ; fp:graphLabel "INVESTS_IN_ASSET_CLASS" .
fp:investsInRegion a owl:ObjectProperty ; rdfs:domain fp:Product ; rdfs:range fp:Region ;
    rdfs:label "투자지역"@ko ; fp:graphLabel "INVESTS_IN_REGION" .
fp:hasBondCategory a owl:ObjectProperty ; rdfs:domain fp:Bond ; rdfs:range fp:BondCategory ;
    rdfs:label "채권분류"@ko ; fp:graphLabel "HAS_BOND_CATEGORY" .
fp:parentCategory a owl:ObjectProperty ; rdfs:domain fp:BondCategory ; rdfs:range fp:BondCategory ;
    rdfs:label "상위 분류"@ko ; fp:graphLabel "PARENT_CATEGORY" ;
    rdfs:comment "채권분류 3계층은 트리가 아니라 DAG라 다중값 허용(예: 일반사채의 상위는 회사채·특수채 둘 다). rdfs:subClassOf는 쓰지 않는다 — 클래스 서브섬션(도메인 검사)과 인스턴스 계층을 섞으면 OntologyValidator._ancestors()가 오염된다"@ko .
fp:hasAttribute a owl:ObjectProperty ; rdfs:domain fp:Fund ; rdfs:range fp:AttributeTag ;
    rdfs:label "펀드속성"@ko ; fp:graphLabel "HAS_ATTRIBUTE" .

# =============================================================================
# 4. 공통 데이터 속성
# =============================================================================
fp:productCode a owl:DatatypeProperty ; rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "상품표준코드"@ko ; fp:sourceColumn "pd_no|pd_itm_no|itm_no" .
fp:productName a owl:DatatypeProperty ; rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "상품명"@ko .
fp:productNameAbbr a owl:DatatypeProperty ; rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "상품약어명"@ko .
fp:asOfDate a owl:DatatypeProperty ; rdfs:domain fp:Product ; rdfs:range xsd:date ;
    rdfs:label "데이터 기준일"@ko ; rdfs:comment "제공 스냅샷 고정값 2026-07-11"@ko .
fp:currency a owl:DatatypeProperty ; rdfs:domain fp:Product ; rdfs:range xsd:string ;
    rdfs:label "거래통화"@ko ; fp:sourceColumn "curr_cd|pd_curr_cd" ;
    fp:hasSynonym "원화", "달러", "환노출" .
fp:isSellable a owl:DatatypeProperty ; rdfs:domain fp:Product ; rdfs:range xsd:boolean ;
    rdfs:label "판매가능여부"@ko ;
    rdfs:comment """상품군마다 판정 근거가 다르다.
      ETF/ETN : pd_sale_yn = 'Y'
      공모펀드 : sale_yn = '판매중'  (당사판매는 thco_sale_yn 별도)
      국내채권 : 판매여부 컬럼이 없음 → buyable_quantity > 0 으로 판정한다"""@ko ;
    fp:sourceColumn "pd_sale_yn|sale_yn|tb_domestic_bond.buyable_quantity" .

# =============================================================================
# 5-A. 통제 어휘 — 위험등급 (실측: 1등급이 가장 위험, 6등급이 가장 안전)
#      ※ 이전 초안은 방향이 반대로 정의되어 있었음. v4 실측값으로 정정.
#      해외ETF에는 위험등급 컬럼 자체가 없다.
#      국내ETF는 위험등급을 pd_risk_cd(코드)와 pd_risk_nm(이름) 두 컬럼으로 보유 — 코드형은 valueCode(대표값),
#      이름형은 altValueCode(별칭)로 매핑한다. normalize_value가 이름형을 코드형으로 정규화한다.
#      근거: db/finance_master.db tb_domestic_etf GROUP BY pd_risk_cd, pd_risk_nm (1,734건, 결측 0, 1:1 대응, 2026-09-04 검증)
# =============================================================================
fp:RiskGrade1 a fp:RiskGrade ; rdfs:label "1등급 매우높은위험"@ko ; fp:rank 1 ;
    fp:valueCode "tb_domestic_bond:1", "tb_domestic_etf:PD_RISK_GCD_11", "tb_fund:1.0" ;
    fp:altValueCode "tb_domestic_etf:매우높은위험(1등급)" ;
    fp:hasSynonym "매우높은위험", "매우 높은 위험", "초고위험" .
fp:RiskGrade2 a fp:RiskGrade ; rdfs:label "2등급 높은위험"@ko ; fp:rank 2 ;
    fp:valueCode "tb_domestic_bond:2", "tb_domestic_etf:PD_RISK_GCD_12", "tb_fund:2.0" ;
    fp:altValueCode "tb_domestic_etf:높은위험(2등급)" ;
    fp:hasSynonym "높은위험", "높은 위험" .
fp:RiskGrade3 a fp:RiskGrade ; rdfs:label "3등급 다소높은위험"@ko ; fp:rank 3 ;
    fp:valueCode "tb_domestic_bond:3", "tb_domestic_etf:PD_RISK_GCD_13", "tb_fund:3.0" ;
    fp:altValueCode "tb_domestic_etf:다소높은위험(3등급)" ;
    fp:hasSynonym "다소높은위험", "다소 높은 위험" .
fp:RiskGrade4 a fp:RiskGrade ; rdfs:label "4등급 보통위험"@ko ; fp:rank 4 ;
    fp:valueCode "tb_domestic_bond:4", "tb_domestic_etf:PD_RISK_GCD_14", "tb_fund:4.0" ;
    fp:altValueCode "tb_domestic_etf:보통위험(4등급)" ;
    fp:hasSynonym "보통위험", "보통 위험", "중위험" .
fp:RiskGrade5 a fp:RiskGrade ; rdfs:label "5등급 낮은위험"@ko ; fp:rank 5 ;
    fp:valueCode "tb_domestic_bond:5", "tb_domestic_etf:PD_RISK_GCD_15", "tb_fund:5.0" ;
    fp:altValueCode "tb_domestic_etf:낮은위험(5등급)" ;
    fp:hasSynonym "낮은위험", "낮은 위험", "저위험", "안전한" .
fp:RiskGrade6 a fp:RiskGrade ; rdfs:label "6등급 매우낮은위험"@ko ; fp:rank 6 ;
    fp:valueCode "tb_domestic_bond:6", "tb_domestic_etf:PD_RISK_GCD_16", "tb_fund:6.0" ;
    fp:altValueCode "tb_domestic_etf:매우낮은위험(6등급)" ;
    fp:hasSynonym "매우낮은위험", "매우 낮은 위험", "가장 안전한" .
fp:RiskGradeUnknown a fp:RiskGrade ; rdfs:label "미분류"@ko ;
    fp:valueCode "tb_domestic_bond:0" ;
    rdfs:comment "국내채권 58건. 등급 비교 질의에서 제외한다"@ko .

# =============================================================================
# 5-B. 통제 어휘 — 신용등급 (국내채권 전용, 실측 20종)
#      crd_grd 는 'AA0' 형태, pd_evco_crd_grd 는 'AA' 형태 → hasSynonym 으로 연결
#      "AA- 이상" = rank <= 4   /   투자등급 = rank <= 10 (BBB- 이상)
# =============================================================================
fp:CreditRating_AAA  a fp:CreditRating ; rdfs:label "AAA"  ; fp:rank  1 .
fp:CreditRating_AAp  a fp:CreditRating ; rdfs:label "AA+"  ; fp:rank  2 .
fp:CreditRating_AA   a fp:CreditRating ; rdfs:label "AA0"  ; fp:rank  3 ; fp:hasSynonym "AA" .
fp:CreditRating_AAm  a fp:CreditRating ; rdfs:label "AA-"  ; fp:rank  4 .
fp:CreditRating_Ap   a fp:CreditRating ; rdfs:label "A+"   ; fp:rank  5 .
fp:CreditRating_A    a fp:CreditRating ; rdfs:label "A0"   ; fp:rank  6 ; fp:hasSynonym "A" .
fp:CreditRating_Am   a fp:CreditRating ; rdfs:label "A-"   ; fp:rank  7 .
fp:CreditRating_BBBp a fp:CreditRating ; rdfs:label "BBB+" ; fp:rank  8 .
fp:CreditRating_BBB  a fp:CreditRating ; rdfs:label "BBB0" ; fp:rank  9 ; fp:hasSynonym "BBB" .
fp:CreditRating_BBBm a fp:CreditRating ; rdfs:label "BBB-" ; fp:rank 10 ;
    rdfs:comment "투자등급(Investment Grade) 하한"@ko .
fp:CreditRating_BBp  a fp:CreditRating ; rdfs:label "BB+"  ; fp:rank 11 .
fp:CreditRating_BB   a fp:CreditRating ; rdfs:label "BB0"  ; fp:rank 12 ; fp:hasSynonym "BB" .
fp:CreditRating_BBm  a fp:CreditRating ; rdfs:label "BB-"  ; fp:rank 13 .
fp:CreditRating_Bp   a fp:CreditRating ; rdfs:label "B+"   ; fp:rank 14 .
fp:CreditRating_B    a fp:CreditRating ; rdfs:label "B0"   ; fp:rank 15 ; fp:hasSynonym "B" .
fp:CreditRating_Bm   a fp:CreditRating ; rdfs:label "B-"   ; fp:rank 16 .
fp:CreditRating_CCC  a fp:CreditRating ; rdfs:label "CCC"  ; fp:rank 17 .
fp:CreditRating_CC   a fp:CreditRating ; rdfs:label "CC0"  ; fp:rank 18 ; fp:hasSynonym "CC" .
fp:CreditRating_C    a fp:CreditRating ; rdfs:label "C0"   ; fp:rank 19 ; fp:hasSynonym "C" .

# =============================================================================
# 5-C. 통제 어휘 — 투자자산군 (3개 상품군의 표기가 전부 다름)
#      국내ETF wu_inv_ast_type(한글 8) / 해외ETF wu_inv_ast_type(영문 6) / 펀드 or_attr_desc(11)
# =============================================================================
fp:AssetClass_Equity a fp:AssetClass ; rdfs:label "주식"@ko ;
    fp:valueCode "tb_domestic_etf:주식", "tb_foreign_etf:Equity", "tb_fund:주식형" ;
    fp:hasSynonym "주식형", "Equity", "주식에 투자하는" .
fp:AssetClass_Bond a fp:AssetClass ; rdfs:label "채권"@ko ;
    fp:valueCode "tb_domestic_etf:채권", "tb_foreign_etf:Bond", "tb_fund:채권형" ;
    fp:hasSynonym "채권형", "Bond", "Fixed Income" .
fp:AssetClass_Commodity a fp:AssetClass ; rdfs:label "원자재"@ko ;
    fp:valueCode "tb_domestic_etf:원자재", "tb_foreign_etf:Commodity" ;
    fp:hasSynonym "Commodity", "금", "원유" ; fp:notAvailableIn "tb_fund" .
fp:AssetClass_Mixed a fp:AssetClass ; rdfs:label "혼합자산"@ko ;
    fp:valueCode "tb_domestic_etf:혼합자산", "tb_foreign_etf:Mixed Assets", "tb_fund:혼합자산" ;
    fp:hasSynonym "Mixed Assets", "자산배분" .
fp:AssetClass_MixedEquity a fp:AssetClass ; rdfs:subClassOf fp:AssetClass_Mixed ;
    rdfs:label "주식혼합"@ko ; fp:valueCode "tb_fund:주식혼합" .
fp:AssetClass_MixedBond a fp:AssetClass ; rdfs:subClassOf fp:AssetClass_Mixed ;
    rdfs:label "채권혼합"@ko ; fp:valueCode "tb_fund:채권혼합" .
fp:AssetClass_MoneyMarket a fp:AssetClass ; rdfs:label "단기자금"@ko ;
    fp:valueCode "tb_domestic_etf:단기자금", "tb_foreign_etf:Money Market", "tb_fund:MMF" ;
