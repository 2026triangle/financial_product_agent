# ==============================================================================
# AI Agent Environment Configuration
# ==============================================================================
# LLM: HyperCLOVA X (CLOVA Studio) - 전체 에이전트(QueryParser/TextToSQL/AnswerAgent) 공통 사용
CLOVA_API_KEY=your-clova-api-key-here
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com/v1/openai/
CLOVA_MODEL=HCX-005
DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=4096
DEFAULT_TIMEOUT=60.0
DEFAULT_MAX_RETRIES=3

# Database & MCT Vector Search Settings
FINANCE_DB_PATH=./src/data/db/finance_master.db
BGE_M3_MODEL=BAAI/bge-m3
META_TOP_K=5
META_ALPHA=0.7

# Debug Logging
AGENT_DEBUG=false
